COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE=mainframeOffload
COSMOS_CONTAINER=balances
COSMOS_QUARANTINE_CONTAINER=sync-quarantine
EVENTHUB_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
EVENTHUB_NAME=vsam-changes
EVENTHUB_CONSUMER_GROUP=sync-demo
CHECKPOINT_BLOB_URL=https://<account>.blob.core.windows.net
CHECKPOINT_CONTAINER=sync-checkpoints

# Guided web app: these values are normally injected by infra/guided-app.bicep.
# Set EVENTHUB_CONSUMER_GROUP=guided-demo for this app, not the continuous consumer.
STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net/
RAW_CONTAINER=vsam-raw
CONTROL_CONTAINER=demo-control
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=rg-mainframe-vsam-offload-demo
AZURE_LOCATION=brazilsouth
AZURE_COMPUTE_KIND=containerapp
AZURE_WEBAPP_NAME=app-vsam-demo
# DEMO_ACCESS_TOKEN is generated and injected securely by deploy-guided.ps1.
# Never store the real access code in a committed environment file.
